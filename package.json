{
  "name": "dice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run wasm-pack:dev && next dev",
    "build": "npm run wasm-pack:release && next build",
    "start": "next start",
    "lint": "eslint",
    "wasm-pack": "wasm-pack build crates/dice-wasm --target web --out-name dice_wasm",
    "wasm-pack:dev": "npm run wasm-pack -- --dev",
    "wasm-pack:release": "npm run wasm-pack -- --release",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "clsx": "^2.1.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
